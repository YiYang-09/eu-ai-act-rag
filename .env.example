# copy to .env
LLM_MODEL=qwen2.5:7b
# Ollama running on the host (default). With --profile ollama use http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
# cpu or cuda for the embedder and reranker inside the API container
EMBED_DEVICE=cpu

# Tracing (optional): start with --profile tracing, create a project at http://localhost:3000,
# then paste its keys here and restart the api.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
